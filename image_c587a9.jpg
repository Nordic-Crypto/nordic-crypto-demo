<span class="hljs-comment"># Check missing referenced files in app.html and index.html</span>
<span class="hljs-keyword">for</span> page <span class="hljs-keyword">in</span> [<span class="hljs-string">"app.html"</span>, <span class="hljs-string">"index.html"</span>, <span class="hljs-string">"verify.html"</span>, <span class="hljs-string">"iphone.html"</span>]:
