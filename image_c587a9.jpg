--><pre _ngcontent-ng-c1018527668="" class="ng-tns-c1018527668-130"><code _ngcontent-ng-c1018527668="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c1018527668-130"><span class="hljs-selector-id">#dash</span><span class="hljs-selector-class">.bd-on</span> &gt; <span class="hljs-selector-pseudo">:not</span>(<span class="hljs-selector-id">#bd</span>) { <span class="hljs-attribute">display</span>: none <span class="hljs-meta">!important</span>; }
