scripts = re.findall(<span class="hljs-string">r'&lt;script[^&gt;]*src=[^&gt;]+&gt;'</span>, html)
print(<span class="hljs-string">"CSS links:"</span>, <span class="hljs-built_in">len</span>(links))
<span class="hljs-keyword">for</span> l <span class="hljs-keyword">in</span> links:
    print(<span class="hljs-string">" "</span>, l)
print(<span class="hljs-string">"Scripts:"</span>, <span class="hljs-built_in">len</span>(scripts))
<span class="hljs-keyword">for</span> s <span class="hljs-keyword">in</span> scripts[:<span class="hljs-number">40</span>]:
