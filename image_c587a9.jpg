      <span class="hljs-keyword">else</span> toast(<span class="hljs-string">'Bonus center opened'</span>);
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (act === <span class="hljs-string">'nav'</span>) {
      nav(btn.getAttribute(<span class="hljs-string">'data-v'</span>));
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (act === <span class="hljs-string">'tx'</span>) {
      <span class="hljs-keyword">var</span> idx = <span class="hljs-built_in">parseInt</span>(btn.getAttribute(<span class="hljs-string">'data-i'</span>), <span class="hljs-number">10</span>);
      <span class="hljs-keyword">var</span> item = allTx()[idx];
      <span class="hljs-keyword">if</span> (item &amp;&amp; <span class="hljs-keyword">typeof</span> <span class="hljs-built_in">window</span>.openTxDetails === <span class="hljs-string">'function'</span>) <span class="hljs-built_in">window</span>.openTxDetails(item);
    }
  }

  <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">init</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!build()) { <span class="hljs-built_in">setTimeout</span>(init, <span class="hljs-number">350</span>); <span class="hljs-keyword">return</span>; }
    render(<span class="hljs-literal">true</span>);
    <span class="hljs-built_in">setInterval</span>(<span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params"></span>) </span>{ render(<span class="hljs-literal">false</span>); }, <span class="hljs-number">2000</span>);
    <span class="hljs-built_in">window</span>.addEventListener(<span class="hljs-string">'resize'</span>, <span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params"></span>) </span>{ render(<span class="hljs-literal">true</span>); });
  }

  <span class="hljs-built_in">window</span>.BankDashPro = { <span class="hljs-attr">render</span>: <span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params"></span>) </span>{ render(<span class="hljs-literal">true</span>); }, <span class="hljs-attr">state</span>: B };
  <span class="hljs-keyword">if</span> (<span class="hljs-built_in">document</span>.readyState === <span class="hljs-string">'loading'</span>) <span class="hljs-built_in">document</span>.addEventListener(<span class="hljs-string">'DOMContentLoaded'</span>, init);
