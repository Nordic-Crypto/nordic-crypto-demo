    <span class="hljs-keyword">for</span> r <span class="hljs-keyword">in</span> refs:
        <span class="hljs-keyword">if</span> r.startswith((<span class="hljs-string">"http://"</span>, <span class="hljs-string">"https://"</span>, <span class="hljs-string">"//"</span>, <span class="hljs-string">"data:"</span>, <span class="hljs-string">"mailto:"</span>, <span class="hljs-string">"tel:"</span>, <span class="hljs-string">"javascript:"</span>)):
