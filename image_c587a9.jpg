&lt;link rel="icon" href="logo-32.png?v=3"&gt;&lt;meta name="robots" content="noindex"&gt;
&lt;style&gt;body{margin:0;background:#0b1220;color:#eef4ff;font:16px/1.4 -apple-system,Helvetica,Arial,sans-serif}.w{max-width:560px;margin:0 auto;padding:14px}h1{font-size:22px;margin:8px 0 12px}
.l{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.l a{padding:8px 12px;border-radius:10px;background:#1a2233;color:#eef4ff;text-decoration:none;font-weight:600}.l a.on{background:#c6ff3d;color:#07080c}
img{width:100%;height:auto;display:block;border-radius:16px;margin:0 0 14px;background:#fff}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class="w"&gt;&lt;h1&gt;NordicCrypto — iPhone&lt;/h1&gt;&lt;div class="l" id="l"&gt;&lt;/div&gt;&lt;div id="im"&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script&gt;
var N={en:'English',da:'Dansk',fi:'Suomi',es:'Español',no:'Norsk',sv:'Svenska',fr:'Français',de:'Deutsch'},q=new URLSearchParams(location.search).get('l'),c=q;
try{c=c||localStorage.getItem('nc_lang')}catch(e){}c=N[c]?c:(N[(navigator.language||'en').slice(0,2)]?(navigator.language||'en').slice(0,2):'en');
document.documentElement.lang=c;
document.getElementById('l').innerHTML=Object.keys(N).map(function(k){return '&lt;a href="?l='+k+'"'+(k===c?' class="on"':'')+'&gt;'+N[k]+'&lt;/a&gt;'}).join('');
document.getElementById('im').innerHTML='&lt;img alt="NordicCrypto iPhone" src="iphone-'+c+'.jpg"&gt;';
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;


</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p dir="ltr" data-path-to-node="2" style="--animation-duration: 560ms;"><span>Я проверил файл </span><code data-path-to-node="2" data-index-in-node="16">iphone.html</code><span> в вашем архиве:</span><span> с ним всё в полном порядке (</span><code data-path-to-node="2" data-index-in-node="72">src="iphone-'+c+'.jpg"</code><span> собирается динамически скриптом в зависимости от выбранного языка,</span><span> и все 8 картинок </span><code data-path-to-node="2" data-index-in-node="179">iphone-en.jpg</code><span>,</span><span> </span><code data-path-to-node="2" data-index-in-node="194">iphone-da.jpg</code><span> и т.</span><span>д.</span><span> лежат в корне),</span><span> поэтому </span><b data-path-to-node="2" data-index-in-node="239">Этап 5 трогать не нужно</b><span>.</span></p><p dir="ltr" data-path-to-node="3"><span>Сразу переходим к </span><b data-path-to-node="3" data-index-in-node="18">Этапу 6</b><span> — исправлению зависания экрана после верификации KYC (сейчас проверю точный участок кода в </span><code data-path-to-node="3" data-index-in-node="117">js/app.legacy.js</code><span> и дам готовую замену).</span></p></div><!----></message-content><!----><!----></div></structured-content-container><!----><!----></div><!----><!----></model-response-content><!----><!----><!----><!--