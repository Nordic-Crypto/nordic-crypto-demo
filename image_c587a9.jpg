    var pl = 4, pr = 4, pt = 14, pb = 22, mn = Infinity, mx = -Infinity; pts.forEach(function (p) { mn = Math.min(mn, p.v); mx = Math.max(mx, p.v); });
    var flat = mx - mn &lt; Math.max(1e-6, Math.abs(mx) * 0.0005);
