  <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderComposition</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">var</span> box = $(<span class="hljs-string">'bdCompPanel'</span>);
    <span class="hljs-keyword">if</span> (!box) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">var</span> t = totals();
    <span class="hljs-keyword">var</span> cryptoSum = t.btc + t.eth + t.usdt + t.others;
    <span class="hljs-keyword">var</span> items = cryptoSum &gt; <span class="hljs-number">0</span> ? [
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'BTC'</span>, <span class="hljs-attr">val</span>: t.btc, <span class="hljs-attr">color</span>: <span class="hljs-string">'#2dd4bf'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'ETH'</span>, <span class="hljs-attr">val</span>: t.eth, <span class="hljs-attr">color</span>: <span class="hljs-string">'#6366f1'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'USDT'</span>, <span class="hljs-attr">val</span>: t.usdt, <span class="hljs-attr">color</span>: <span class="hljs-string">'#38bdf8'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'Others'</span>, <span class="hljs-attr">val</span>: t.others, <span class="hljs-attr">color</span>: <span class="hljs-string">'#94a3b8'</span> }
    ] : [
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'BTC'</span>, <span class="hljs-attr">val</span>: <span class="hljs-number">42.8</span>, <span class="hljs-attr">color</span>: <span class="hljs-string">'#2dd4bf'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'ETH'</span>, <span class="hljs-attr">val</span>: <span class="hljs-number">28.1</span>, <span class="hljs-attr">color</span>: <span class="hljs-string">'#6366f1'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'USDT'</span>, <span class="hljs-attr">val</span>: <span class="hljs-number">18.3</span>, <span class="hljs-attr">color</span>: <span class="hljs-string">'#38bdf8'</span> },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">'Others'</span>, <span class="hljs-attr">val</span>: <span class="hljs-number">10.8</span>, <span class="hljs-attr">color</span>: <span class="hljs-string">'#94a3b8'</span> }
    ];
    <span class="hljs-keyword">var</span> sum = items.reduce(<span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params">acc, x</span>) </span>{ <span class="hljs-keyword">return</span> acc + x.val; }, <span class="hljs-number">0</span>) || <span class="hljs-number">1</span>;
    <span class="hljs-keyword">var</span> R = <span class="hljs-number">52</span>;
    <span class="hljs-keyword">var</span> C = <span class="hljs-number">2</span> * <span class="hljs-built_in">Math</span>.PI * R;
    <span class="hljs-keyword">var</span> offset = <span class="hljs-number">0</span>;

    <span class="hljs-keyword">var</span> circles = items.map(<span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params">it</span>) </span>{
      <span class="hljs-keyword">var</span> len = (it.val / sum) * C;
      <span class="hljs-keyword">var</span> seg = <span class="hljs-string">'&lt;circle cx="73" cy="73" r="'</span> + R + <span class="hljs-string">'" fill="none" stroke="'</span> + it.color + <span class="hljs-string">'" stroke-width="18" '</span> +
                <span class="hljs-string">'stroke-dasharray="'</span> + <span class="hljs-built_in">Math</span>.max(<span class="hljs-number">0</span>, len - <span class="hljs-number">2</span>).toFixed(<span class="hljs-number">2</span>) + <span class="hljs-string">' '</span> + C.toFixed(<span class="hljs-number">2</span>) + <span class="hljs-string">'" '</span> +
                <span class="hljs-string">'stroke-dashoffset="'</span> + (-offset).toFixed(<span class="hljs-number">2</span>) + <span class="hljs-string">'" transform="rotate(-90 73 73)"/&gt;'</span>;
      offset += len;
      <span class="hljs-keyword">return</span> seg;
    }).join(<span class="hljs-string">''</span>);

    <span class="hljs-keyword">var</span> legend = items.map(<span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params">it</span>) </span>{
      <span class="hljs-keyword">var</span> pct = ((it.val / sum) * <span class="hljs-number">100</span>).toFixed(<span class="hljs-number">1</span>);
      <span class="hljs-keyword">return</span> <span class="hljs-string">'&lt;li&gt;&lt;span&gt;&lt;i style="background:'</span> + it.color + <span class="hljs-string">'"&gt;&lt;/i&gt;'</span> + it.name + <span class="hljs-string">'&lt;/span&gt;&lt;b&gt;'</span> + pct + <span class="hljs-string">'%&lt;/b&gt;&lt;/li&gt;'</span>;
    }).join(<span class="hljs-string">''</span>);

    <span class="hljs-keyword">var</span> centerTotal = <span class="hljs-string">'$'</span> + <span class="hljs-built_in">Math</span>.round(t.total).toLocaleString(<span class="hljs-string">'en-US'</span>);

    box.innerHTML =
      <span class="hljs-string">'&lt;div class="bd-sec-hdr"&gt;&lt;h3&gt;Portfolio Composition&lt;/h3&gt;&lt;/div&gt;'</span> +
      <span class="hljs-string">'&lt;div class="bd-comp-wrap"&gt;'</span> +
        <span class="hljs-string">'&lt;div class="bd-donut-box"&gt;'</span> +
          <span class="hljs-string">'&lt;svg viewBox="0 0 146 146" width="146" height="146"&gt;'</span> +
            <span class="hljs-string">'&lt;circle cx="73" cy="73" r="'</span> + R + <span class="hljs-string">'" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="18"/&gt;'</span> +
            circles +
          <span class="hljs-string">'&lt;/svg&gt;'</span> +
          <span class="hljs-string">'&lt;div class="bd-donut-center"&gt;&lt;b class="bd-sens"&gt;'</span> + esc(centerTotal) + <span class="hljs-string">'&lt;/b&gt;&lt;small&gt;Total Value&lt;/small&gt;&lt;/div&gt;'</span> +
        <span class="hljs-string">'&lt;/div&gt;'</span> +
        <span class="hljs-string">'&lt;ul class="bd-comp-leg"&gt;'</span> + legend + <span class="hljs-string">'&lt;/ul&gt;'</span> +
      <span class="hljs-string">'&lt;/div&gt;'</span>;
  }

  <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderSecurity</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">var</span> box = $(<span class="hljs-string">'bdSecPanel'</span>);
