      while (hi - lo &gt; 1) { var mid = (lo + hi) &gt;&gt; 1; if (pts[mid].t &lt;= tt) lo = mid; else hi = mid; }
      var p = (tt - pts[lo].t) &lt; (pts[hi].t - tt) ? pts[lo] : pts[hi], x = X(p.t), y = Y(p.v);
