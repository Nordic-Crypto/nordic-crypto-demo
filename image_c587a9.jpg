=== js/kyc-fix.js ===
/* ============================================================
   KYC SCREEN FIX v3.5 — не перебиваем pendingScreen
   ============================================================ */
(function () {
  'use strict';

  function log() {
    console.log.apply(console, ['[NC-Fix v3.5]'].concat([].slice.call(arguments)));
  }

  function isPendingVisible() {
    var p = document.getElementById('pendingScreen');
    if (!p) return false;
    return p.classList.contains('on') || p.style.display === 'flex';
  }

  function forceShowPending() {
    var p = document.getElementById('pendingScreen');
    if (!p) return;
    p.classList.add('on');
    p.style.cssText = 'display:flex !important;visibility:visible !important;opacity:1 !important;z-index:99999 !important;position:fixed !important;inset:0 !important;';

    ['verifyScreen', 'rejectedScreen', 'onboard', 'loginScreen'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) { el.classList.remove('on'); el.style.display = 'none'; }
    });
    var side = document.getElementById('sideBar');
    if (side) side.style.display = 'none';
    var main = document.getElementById('mainApp');
    if (main) main.style.display = 'none';
  }

  function applyFix() {
    if (typeof st === 'undefined' || !st) return;
    if (window.__ncLoadFailed) return;                       // экран ошибки загрузки важнее
    var boot = document.getElementById('ncBootOverlay');
    if (boot &amp;&amp; boot.classList.contains('on')) return;       // идёт загрузка/ошибка — не вмешиваемся
    var status = (st.verification &amp;&amp; st.verification.status) || null;
    if (status !== 'pending') return;
    if (isPendingVisible()) return;

    var main = document.getElementById('mainApp');
    var side = document.getElementById('sideBar');
    if (main &amp;&amp; main.style.display === 'flex') return;
    if (side &amp;&amp; side.style.display === 'flex') return;

    log('status=pending, app скрыт → forceShow');
    forceShowPending();
  }

  setInterval(applyFix, 5000);

  document.addEventListener('nc:auth:login', function () {
    setTimeout(applyFix, 500);
    setTimeout(applyFix, 1500);
  });

  document.addEventListener('nc:kyc:submit', function () {
    log('📨 nc:kyc:submit — проверю pending через 2 сек');
    setTimeout(function () {
      if (!isPendingVisible()) {
        log('⚠️ pending не показан через 2 сек → forceShow');
        forceShowPending();
      } else {
        log('✅ pending уже показан — не трогаю');
      }
    }, 2000);
  });

  setTimeout(applyFix, 800);

  log('🛡️ KYC screen fix v3.5 loaded');
})();

=== css/bankdash-pro.css ===
/* NORDIC CRYPTO — Banking Dashboard Pro v1.0 (renders in #bd inside #dash) */
#dash.bd-on &gt; .nc3-dashboard { display: none !important; }
.bd {
  --bd-card: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.012)); --bd-s1: rgba(255,255,255,.04); --bd-s2: rgba(255,255,255,.08);
  --bd-bd: rgba(255,255,255,.08); --bd-bd2: rgba(255,255,255,.15); --bd-tx: var(--txt, #f1f5fb); --bd-mut: var(--mut, #8d9bb0);
  --bd-acc: var(--nc-acc, #c8ff4d); --bd-ink: var(--nc-ink, #0b1405); --bd-acc2: #8b5cf6; --bd-up: #2fe3a2; --bd-dn: #ff5470;
  max-width: 1480px; margin: 0 auto; padding: 4px 0 60px; color: var(--bd-tx);
  display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 18px; align-items: start; -webkit-font-smoothing: antialiased; font-feature-settings: "tnum";
}
.bd *, .bd *::before, .bd *::after { box-sizing: border-box; }
.bd button, .bd input { font-family: inherit; }
.bd button { cursor: pointer; }
.bd h3, .bd p { margin: 0; }
.bd .up { color: var(--bd-up); } .bd .dn { color: var(--bd-dn); } .bd .bd-mut { color: var(--bd-mut); }
.bd.hide .bd-sens { filter: blur(9px); user-select: none; transition: filter .2s; }
.bd-main, .bd-side { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.bd-card { background: var(--bd-card), var(--pan, #111827); border: 1px solid var(--bd-bd); border-radius: 24px; padding: 22px; position: relative; min-width: 0; box-shadow: 0 24px 50px -32px rgba(0,0,0,.7); }
.bd-k { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--bd-mut); }
.bd-card h3 { font-size: 18px; font-weight: 800; letter-spacing: -.01em; margin-top: 3px; }
.bd-ch { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
.bd-link { display: inline-flex; align-items: center; gap: 4px; background: none; border: 0; color: var(--bd-acc); font-weight: 700; font-size: 13px; padding: 4px 0; white-space: nowrap; }
.bd-link:hover { text-decoration: underline; }
.bd-ib { width: 42px; height: 42px; border-radius: 14px; background: var(--bd-s1); border: 1px solid var(--bd-bd2); color: var(--bd-mut); display: grid; place-items: center; transition: .15s; }
.bd-ib:hover { color: var(--bd-tx); border-color: var(--bd-acc); } .bd-ib.sm { width: 38px; height: 38px; border-radius: 12px; color: var(--bd-acc); }
.bd-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 14px; border: 1px solid var(--bd-bd2); background: var(--bd-s2); color: var(--bd-tx); font-weight: 800; font-size: 14px; transition: .15s; }
.bd-btn:hover { filter: brightness(1.12); transform: translateY(-1px); }
.bd-btn.pri { background: var(--bd-acc); color: var(--bd-ink); border: 0; box-shadow: 0 12px 26px -12px color-mix(in srgb, var(--bd-acc) 80%, transparent); }
.bd-btn.ghost { background: var(--bd-s1); } .bd-btn.full { width: 100%; margin-top: 14px; }

/* hero */
.bd-hero { padding: 24px 24px 12px; background: radial-gradient(620px 260px at 100% -20%, color-mix(in srgb, var(--bd-acc) 10%, transparent), transparent 60%), radial-gradient(520px 240px at 0% 0%, color-mix(in srgb, var(--bd-acc) 16%, transparent), transparent 60%), var(--bd-card), var(--pan, #111827); overflow: hidden; }
.bd-hero-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.bd-hi { display: flex; align-items: center; gap: 9px; color: var(--bd-mut); font-size: 14px; font-weight: 600; } .bd-hi b { color: var(--bd-tx); }
.bd-live i { display: block; width: 8px; height: 8px; border-radius: 50%; background: var(--bd-up); box-shadow: 0 0 0 0 rgba(34,211,160,.6); animation: bdPulse 2s infinite; }
@keyframes bdPulse { 70% { box-shadow: 0 0 0 7px rgba(34,211,160,0); } 100% { box-shadow: 0 0 0 0 rgba(34,211,160,0); } }
.bd-bal { font-size: clamp(38px, 6.4vw, 60px); font-weight: 800; letter-spacing: -.045em; line-height: 1.05; margin: 6px 0 10px; font-variant-numeric: tabular-nums
=== css/topbar-pro.css ===
/* NordicCrypto — Top bar PRO v1.0 */
.top.tbp {
  position: sticky; top: 0; z-index: 60; display: flex !important; align-items: center; justify-content: space-between; gap: 14px;
  min-height: 68px; padding: 10px clamp(12px, 2.2vw, 30px) !important;
  background: linear-gradient(180deg, rgba(10,16,28,.92), rgba(10,16,28,.8)) !important; -webkit-backdrop-filter: blur(16px) saturate(1.3); backdrop-filter: blur(16px) saturate(1.3);
  border-bottom: 1px solid rgba(255,255,255,.07) !important; box-shadow: 0 10px 30px -22px rgba(0,0,0,.8);
}
.top.tbp::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, transparent, rgba(98,232,194,.35), rgba(77,255,210,.25), transparent); opacity: .55; pointer-events: none; }

/* search */
.tbp .top-search { position: relative; flex: 1 1 auto; max-width: 480px; min-width: 0; height: 44px; border-radius: 14px !important; background: rgba(255,255,255,.045) !important; border: 1px solid rgba(255,255,255,.09) !important; transition: border-color .15s, box-shadow .15s, background .15s; display: flex; align-items: center; }
.tbp .top-search:focus-within { border-color: rgba(98,232,194,.6) !important; box-shadow: 0 0 0 4px rgba(98,232,194,.1); background: rgba(255,255,255,.07) !important; }
.tbp .top-search input { min-width: 0; }
.tbp-kbd { margin-right: 12px; flex: none; font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: #8d9bb0; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-bottom-width: 2px; border-radius: 7px; padding: 5px 8px; }
.tbp .top-search:focus-within .tbp-kbd { display: none; }

/* right cluster */
.tbp-cl { display: flex !important; align-items: center; gap: 8px !important; flex: 0 0 auto; }
.tbp-rw { order: 1; } .tbp-t { order: 2; } .tbp-bell { order: 3; } .tbp-st { order: 4; } .tbp-tg { order: 5; } .tbp-br { order: 6; }
.top.tbp .tbp-tg, .top.tbp .tbp-br { display: none !important; }

/* language switcher: never hidden, own compact look */
.tbp-lang { order: 2; display: inline-block !important; position: relative; z-index: 60; }
.tbp-lang .nc-lang-btn { height: 42px; border-radius: 13px !important; padding: 0 11px !important; background: rgba(255,255,255,.045) !important; border: 1px solid rgba(255,255,255,.09) !important; font-weight: 700; font-size: 13px; }
.tbp-lang .nc-lang-btn:hover { border-color: rgba(98,232,194,.5) !important; }
.tbp-lang .nc-lang-menu { z-index: 9999 !important; max-height: 70vh; overflow-y: auto; }

/* unified controls */
.tbp-t, .tbp-bell, .tbp-t .curr-btn-top, .tbp-tg {
  height: 42px !important; min-width: 42px; box-sizing: border-box; display: inline-flex !important; align-items: center; justify-content: center; gap: 7px;
  border-radius: 13px !important; background: rgba(255,255,255,.045) !important; border: 1px solid rgba(255,255,255,.09) !important; color: var(--txt, #f1f5fb) !important;
  font-weight: 700; font-size: 13px; transition: background .15s, border-color .15s, transform .15s; cursor: pointer; padding: 0 11px; position: relative; margin: 0;
}
.tbp-t:hover, .tbp-bell:hover, .tbp-t .curr-btn-top:hover, .tbp-tg:hover { background: rgba(255,255,255,.09) !important; border-color: rgba(98,232,194,.5) !important; transform: translateY(-1px); }
.tbp-t.curr-switch { padding: 0 !important; background: transparent !important; border: 0 !important; overflow: visible; }
.tbp-t.curr-switch:hover { transform: none; background: transparent !important; }
.tbp-t svg, .tbp-bell svg { width: 18px; height: 18px; flex: none; }
.tbp-bell .notif-badge { position: absolute; top: -5px; right: -5px; min-width: 19px; height: 19px; border-radius: 10px; background: #ff5470; color: #fff; font-size: 10.5px; font-weight: 800; display: grid; place-items: center; padding: 0 5px; border: 2px solid #0a101c; box-shadow: 0 4px 10px -2px rgba(255,84,112,.6); }
.tbp-bell.has::after, .tbp-bell:has(.notif-badge:not([style*="none"]))::after { content: ''; positio

