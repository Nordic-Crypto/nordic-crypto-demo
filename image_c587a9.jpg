    &lt;button class="top-icon" id="btnRefreshBalance" title="Refresh balance"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"&gt;&lt;path d="M23 4v6h-6"/&gt;&lt;path d="M1 20v-6h6"/&gt;&lt;path d="M3.51 9a9 9 0 0114.85-3.36L23 10"/&gt;&lt;path d="M1 14l4.64 4.36A9 9 0 0020.49 15"/&gt;&lt;/svg&gt;&lt;/button&gt;
