  <span class="hljs-attribute">justify-content</span>: center;
  <span class="hljs-attribute">text-align</span>: center;
  <span class="hljs-attribute">pointer-events</span>: none;
}

<span class="hljs-selector-class">.bd-donut-center</span> <span class="hljs-selector-tag">b</span> { <span class="hljs-attribute">font-size</span>: <span class="hljs-number">16px</span>; <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">800</span>; <span class="hljs-attribute">color</span>: <span class="hljs-number">#fff</span>; }
