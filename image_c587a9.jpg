}

<span class="hljs-comment">/* Security Card (Col 3 Bottom) */</span>
<span class="hljs-selector-class">.bd-sec-card</span> {
  <span class="hljs-attribute">position</span>: relative;
  <span class="hljs-attribute">overflow</span>: hidden;
}

