print(<span class="hljs-string">"... total scripts:"</span>, <span class="hljs-built_in">len</span>(scripts))
<span class="hljs-keyword">for</span> s <span class="hljs-keyword">in</span> scripts[-<span class="hljs-number">20</span>:]:
    print(<span class="hljs-string">" "</span>, s)

