  <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">render</span>(<span class="hljs-params">force</span>) </span>{
    <span class="hljs-keyword">if</span> (!B.built &amp;&amp; !build()) <span class="hljs-keyword">return</span>;
