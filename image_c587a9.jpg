      <span class="hljs-string">'&lt;/button&gt;'</span>;
    }).join(<span class="hljs-string">''</span>) : <span class="hljs-string">'&lt;div style="color:#7f94a3;font-size:13px;padding:24px 0;text-align:center"&gt;No recent transactions yet&lt;/div&gt;'</span>;

    box.innerHTML =
