  <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">onClick</span>(<span class="hljs-params">e</span>) </span>{
    <span class="hljs-keyword">var</span> btn = e.target.closest(<span class="hljs-string">'[data-a]'</span>);
    <span class="hljs-keyword">if</span> (!btn) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">var</span> act = btn.getAttribute(<span class="hljs-string">'data-a'</span>);
    <span class="hljs-keyword">if</span> (act === <span class="hljs-string">'eye'</span>) {
      B.hide = !B.hide;
      lsSet(<span class="hljs-string">'bd_hide'</span>, B.hide ? <span class="hljs-string">'1'</span> : <span class="hljs-string">'0'</span>);
      render(<span class="hljs-literal">true</span>);
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (act === <span class="hljs-string">'rng'</span>) {
