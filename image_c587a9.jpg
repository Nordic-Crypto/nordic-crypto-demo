<span class="hljs-selector-id">#dash</span><span class="hljs-selector-class">.bd-on</span> &gt; <span class="hljs-selector-class">.nc3-dashboard</span> { <span class="hljs-attribute">display</span>: none <span class="hljs-meta">!important</span>; }

<span class="hljs-selector-tag">body</span> {
  <span class="hljs-attribute">background</span>: <span class="hljs-number">#050b10</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-number">#eef5f8</span> <span class="hljs-meta">!important</span>;
}

<span class="hljs-comment">/* Panoramic Nordic mountain glow behind top header &amp; greeting */</span>
<span class="hljs-selector-id">#mainApp</span> {
  <span class="hljs-attribute">position</span>: relative;
  <span class="hljs-attribute">background</span>:
    <span class="hljs-built_in">linear-gradient</span>(<span class="hljs-number">180deg</span>, <span class="hljs-built_in">rgba</span>(<span class="hljs-number">6</span>, <span class="hljs-number">14</span>, <span class="hljs-number">20</span>, <span class="hljs-number">0.35</span>) <span class="hljs-number">0%</span>, <span class="hljs-built_in">rgba</span>(<span class="hljs-number">5</span>, <span class="hljs-number">11</span>, <span class="hljs-number">16</span>, <span class="hljs-number">0.88</span>) <span class="hljs-number">280px</span>, <span class="hljs-number">#050b10</span> <span class="hljs-number">420px</span>),
    <span class="hljs-built_in">radial-gradient</span>(<span class="hljs-number">1100px</span> <span class="hljs-number">360px</span> at <span class="hljs-number">55%</span> <span class="hljs-number">0%</span>, <span class="hljs-built_in">rgba</span>(<span class="hljs-number">56</span>, <span class="hljs-number">189</span>, <span class="hljs-number">178</span>, <span class="hljs-number">0.22</span>), transparent <span class="hljs-number">70%</span>),
    <span class="hljs-built_in">url</span>(<span class="hljs-string">'../silk-bg.jpg'</span>) center top / cover no-repeat,
    <span class="hljs-number">#050b10</span> <span class="hljs-meta">!important</span>;
}

<span class="hljs-comment">/* Sidebar styling matching reference */</span>
<span class="hljs-selector-id">#sideBar</span><span class="hljs-selector-class">.side</span> {
  <span class="hljs-attribute">background</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">7</span>, <span class="hljs-number">15</span>, <span class="hljs-number">21</span>, <span class="hljs-number">0.94</span>) <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">border-right</span>: <span class="hljs-number">1px</span> solid <span class="hljs-built_in">rgba</span>(<span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">0.06</span>) <span class="hljs-meta">!important</span>;
  backdrop-<span class="hljs-attribute">filter</span>: <span class="hljs-built_in">blur</span>(<span class="hljs-number">20px</span>);
}

<span class="hljs-selector-id">#sideBar</span> <span class="hljs-selector-class">.menu</span> <span class="hljs-selector-class">.mi</span> {
  <span class="hljs-attribute">border-radius</span>: <span class="hljs-number">12px</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">margin</span>: <span class="hljs-number">3px</span> <span class="hljs-number">12px</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">padding</span>: <span class="hljs-number">11px</span> <span class="hljs-number">14px</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-number">#8fa3b0</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">600</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">transition</span>: all <span class="hljs-number">0.18s</span> ease;
}

<span class="hljs-selector-id">#sideBar</span> <span class="hljs-selector-class">.menu</span> <span class="hljs-selector-class">.mi</span><span class="hljs-selector-pseudo">:hover</span> {
  <span class="hljs-attribute">background</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">0.05</span>) <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-number">#eef5f8</span> <span class="hljs-meta">!important</span>;
}

<span class="hljs-selector-id">#sideBar</span> <span class="hljs-selector-class">.menu</span> <span class="hljs-selector-class">.mi</span><span class="hljs-selector-class">.on</span> {
  <span class="hljs-attribute">background</span>: <span class="hljs-built_in">linear-gradient</span>(<span class="hljs-number">135deg</span>, <span class="hljs-number">#4ae8b5</span> <span class="hljs-number">0%</span>, <span class="hljs-number">#2dd4bf</span> <span class="hljs-number">100%</span>) <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-number">#041814</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">700</span> <span class="hljs-meta">!important</span>;
  <span class="hljs-attribute">box-shadow</span>: <span class="hljs-number">0</span> <span class="hljs-number">8px</span> <span class="hljs-number">24px</span> -<span class="hljs-number">6px</span> <span class="hljs-built_in">rgba</span>(<span class="hljs-number">69</span>, <span class="hljs-number">230</span>, <span class="hljs-number">176</span>, <span class="hljs-number">0.45</span>) <span class="hljs-meta">!important</span>;
}

<span class="hljs-selector-id">#sideBar</span> <span class="hljs-selector-class">.menu</span> <span class="hljs-selector-class">.mi</span><span class="hljs-selector-class">.on</span> svg {
  stroke: <span class="hljs-number">#041814</span> <span class="hljs-meta">!important</span>;
}

<span class="hljs-comment">/* Main Dashboard Grid */</span>
<span class="hljs-selector-class">.bd</span> {
  --bd-bg-card: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">11</span>, <span class="hljs-number">21</span>, <span class="hljs-number">29</span>, <span class="hljs-number">0.78</span>);
  --bd-bg-card-<span class="hljs-number">2</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">15</span>, <span class="hljs-number">28</span>, <span class="hljs-number">38</span>, <span class="hljs-number">0.85</span>);
  --bd-bd: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">255</span>, <span class="hljs-number">0.08</span>);
  --bd-bd-hi: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">69</span>, <span class="hljs-number">230</span>, <span class="hljs-number">176</span>, <span class="hljs-number">0.28</span>);
  --bd-tx: <span class="hljs-number">#eef5f8</span>;
  --bd-mut: <span class="hljs-number">#7f94a3</span>;
  --bd-mint: <span class="hljs-number">#45e6b0</span>;
  --bd-mint-<span class="hljs-number">2</span>: <span class="hljs-number">#2dd4bf</span>;
  --bd-ink: <span class="hljs-number">#041814</span>;
  --bd-up: <span class="hljs-number">#34d399</span>;
  --bd-dn: <span class="hljs-number">#f87171</span>;

  <span class="hljs-attribute">max-width</span>: <span class="hljs-number">1520px</span>;
  <span class="hljs-attribute">margin</span>: <span class="hljs-number">0</span> auto;
  <span class="hljs-attribute">padding</span>: <span class="hljs-number">6px</span> <span class="hljs-number">8px</span> <span class="hljs-number">48px</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--bd-tx);
  <span class="hljs-attribute">font-family</span>: <span class="hljs-string">'Inter'</span>, -apple-system, BlinkMacSystemFont, sans-serif;
  <span class="hljs-attribute">font-feature-settings</span>: <span class="hljs-string">"tnum"</span>;
  -webkit-<span class="hljs-attribute">font</span>-smoothing: antialiased;
}

<span class="hljs-selector-class">.bd</span> *, <span class="hljs-selector-class">.bd</span> *<span class="hljs-selector-pseudo">::before</span>, <span class="hljs-selector-class">.bd</span> *<span class="hljs-selector-pseudo">::after</span> { <span class="hljs-attribute">box-sizing</span>: border-box; }
<span class="hljs-selector-class">.bd</span> <span class="hljs-selector-tag">button</span> { <span class="hljs-attribute">font-family</span>: inherit; <span class="hljs-attribute">cursor</span>: pointer; }
<span class="hljs-selector-class">.bd</span><span class="hljs-selector-class">.hide</span> <span class="hljs-selector-class">.bd-sens</span> { <span class="hljs-attribute">filter</span>: <span class="hljs-built_in">blur</span>(<span class="hljs-number">8px</span>); user-select: none; }

<span class="hljs-comment">/* Greeting Row */</span>
<span class="hljs-selector-class">.bd-greet-row</span> {
  <span class="hljs-attribute">display</span>: flex;
  <span class="hljs-attribute">justify-content</span>: space-between;
  <span class="hljs-attribute">align-items</span>: flex-end;
  gap: <span class="hljs-number">16px</span>;
  <span class="hljs-attribute">margin-bottom</span>: <span class="hljs-number">20px</span>;
  <span class="hljs-attribute">padding</span>: <span class="hljs-number">4px</span> <span class="hljs-number">2px</span>;
}

<span class="hljs-selector-class">.bd-greet-title</span> {
  <span class="hljs-attribute">font-size</span>: <span class="hljs-built_in">clamp</span>(<span class="hljs-number">24px</span>, <span class="hljs-number">2.6vw</span>, <span class="hljs-number">32px</span>);
  <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">800</span>;
  <span class="hljs-attribute">letter-spacing</span>: -<span class="hljs-number">0.03em</span>;
  <span class="hljs-attribute">color</span>: <span class="hljs-number">#ffffff</span>;
  <span class="hljs-attribute">margin</span>: <span class="hljs-number">0</span> <span class="hljs-number">0</span> <span class="hljs-number">4px</span>;
  <span class="hljs-attribute">text-shadow</span>: <span class="hljs-number">0</span> <span class="hljs-number">2px</span> <span class="hljs-number">16px</span> <span class="hljs-built_in">rgba</span>(<span class="hljs-number">0</span>, <span class="hljs-number">0</span>, <span class="hljs-number">0</span>, <span class="hljs-number">0.45</span>);
