      &lt;div class="nc3-section-head"&gt;&lt;div&gt;&lt;div class="nc3-kicker"&gt;Shortcuts&lt;/div&gt;&lt;h2&gt;Move money&lt;/h2&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class="nc3-action-grid"&gt;
        &lt;button class="nc3-action" id="btnWithdrawV2"&gt;
          &lt;span class="nc3-action-icon orange"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"&gt;&lt;path d="M12 19V5"/&gt;&lt;path d="M5 12l7-7 7 7"/&gt;&lt;/svg&gt;&lt;/span&gt;
          &lt;span&gt;&lt;b&gt;Withdraw&lt;/b&gt;&lt;small&gt;Cash out to your account&lt;/small&gt;&lt;/span&gt;
          &lt;span&gt;↗&lt;/span&gt;
        &lt;/button&gt;
        &lt;button class="nc3-action" id="btnExchangeV2"&gt;
          &lt;span class="nc3-action-icon pink"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"&gt;&lt;path d="M7 16V4M7 4L3 8M7 4l4 4"/&gt;&lt;path d="M17 8v12M17 20l4-4M17 20l-4-4"/&gt;&lt;/svg&gt;&lt;/span&gt;
          &lt;span&gt;&lt;b&gt;Exchange&lt;/b&gt;&lt;small&gt;Swap crypto instantly&lt;/small&gt;&lt;/span&gt;
          &lt;span&gt;→&lt;/span&gt;
        &lt;/button&gt;
        &lt;button class="nc3-action" id="btnCopyCardV2"&gt;
          &lt;span class="nc3-action-icon green"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"&gt;&lt;rect x="9" y="9" width="13" height="13" rx="2"/&gt;&lt;path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/&gt;&lt;/svg&gt;&lt;/span&gt;
          &lt;span&gt;&lt;b&gt;Copy card&lt;/b&gt;&lt;small&gt;Card number&lt;/small&gt;&lt;/span&gt;
          &lt;span&gt;→&lt;/span&gt;
        &lt;/button&gt;
        &lt;button class="nc3-action" id="btnReceiveMoney"&gt;
          &lt;span class="nc3-action-icon cyan"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"&gt;&lt;path d="M12 5v14"/&gt;&lt;path d="M19 12l-7 7-7-7"/&gt;&lt;/svg&gt;&lt;/span&gt;
          &lt;span&gt;&lt;b&gt;Receive money&lt;/b&gt;&lt;small&gt;Your IBAN&lt;/small&gt;&lt;/span&gt;
          &lt;span&gt;→&lt;/span&gt;
        &lt;/button&gt;
      &lt;/div&gt;
    &lt;/section&gt;

    &lt;section class="nc3-lower"&gt;
      &lt;div class="nc3-chart-panel"&gt;
        &lt;div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"&gt;&lt;div&gt;&lt;div class="nc3-kicker"&gt;Balance history&lt;/div&gt;&lt;h2 style="font-size:1.05rem"&gt;Last 7 days&lt;/h2&gt;&lt;/div&gt;&lt;strong id="balanceCurrent" style="font-family:ui-monospace;color:#62ddff"&gt;$0.00&lt;/strong&gt;&lt;/div&gt;
        &lt;div id="balanceChartSecondary" style="height:270px"&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="nc3-transactions"&gt;
        &lt;div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"&gt;&lt;div&gt;&lt;div class="nc3-kicker"&gt;Activity&lt;/div&gt;&lt;h2 style="font-size:1.05rem"&gt;Recent transactions&lt;/h2&gt;&lt;/div&gt;&lt;a href="#" id="viewAllTx" style="color:#65ddff;text-decoration:none;font-size:.72rem;font-weight:750"&gt;View all&lt;/a&gt;&lt;/div&gt;
        &lt;div class="recent-tx-list" id="recentTxList"&gt;
          &lt;div class="recent-tx-empty"&gt;No transactions yet&lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/section&gt;

    &lt;section class="nc3-bottom-row"&gt;
      &lt;div class="nc3-iban"&gt;
        &lt;div class="nc3-iban-copy"&gt;
          &lt;div class="nc3-icon-circle"&gt;🏦&lt;/div&gt;
          &lt;div&gt;&lt;div class="nc3-kicker"&gt;Bank details&lt;/div&gt;&lt;h3 id="ibanTitle" style="color:#e8f4ff"&gt;Receive by IBAN&lt;/h3&gt;&lt;p style="color:#7c9cbb;font-size:12px"&gt;Share your account details securely.&lt;/p&gt;&lt;/div&gt;
        &lt;/div&gt;
        &lt;div id="ibanPending" class="iban-pending"&gt;&lt;div class="iban-spinner"&gt;&lt;/div&gt;&lt;div class="iban-pending-text"&gt;Your IBAN is being generated...&lt;/div&gt;&lt;div class="iban-pending-sub"&gt;This usually takes a few minutes&lt;/div&gt;&lt;/div&gt;
        &lt;div id="ibanReady" class="nc3-iban-details" style="display:none"&gt;
          &lt;div&gt;&lt;span&gt;IBAN&lt;/span&gt;&lt;b id="myIban"&gt;—&lt;/b&gt;&lt;/div&gt;
          &lt;div&gt;&lt;span&gt;SWIFT / BIC&lt;/span&gt;&lt;b id="mySwift"&gt;ESSESESSXXX&lt;/b&gt;&lt;/div&gt;
          &lt;div&gt;&lt;span&gt;Bank&lt;/span&gt;&lt;b id="myBank"&gt;NordicCrypto Bank AB&lt;/b&gt;&lt;/div&gt;
          &lt;div&gt;&lt;span&gt;Country&lt;/span&gt;&lt;b id="myCountry"&gt;—&lt;/b&gt;&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class="nc3-copy-iban" id="btnCopyIban"&gt;📋 Copy details&lt;/button&gt;
      &lt;/div&gt;

      &lt;div class="nc3-stat-strip"&gt;
        &lt;div class="nc3-stat"&gt;
          &lt;div class="nc3-stat-icon green"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"&gt;&lt;rect x="2" y="6" width="20" height="12" rx="2"/&gt;&lt;circle cx="12" cy="12" r="3"/&gt;&lt;/svg&gt;&lt;/div&gt;
          &lt;span&gt;Deposited&lt;/span&gt;
          &lt;strong id="statIncome"&gt;$0.00&lt;/strong&gt;
          &lt;small&gt;Total income&lt;/small&gt;
        &lt;/div&gt;
        &lt;div class="nc3-stat"&gt;
          &lt;div class="nc3-stat-icon red"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"&gt;&lt;path d="M3 17l6-6 4 4 8-8"/&gt;&lt;path d="M17 7h4v4"/&gt;&lt;/svg&gt;&lt;/div&gt;
          &lt;span&gt;Spent&lt;/span&gt;
          &lt;strong id="statSpending"&gt;$0.00&lt;/strong&gt;
          &lt;small&gt;Total spending&lt;/small&gt;
        &lt;/div&gt;
        &lt;div class="nc3-stat"&gt;
          &lt;div class="nc3-stat-icon cyan"&gt;&lt;svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"&gt;&lt;line x1="12" y1="20" x2="12" y2="10"/&gt;&lt;line x1="18" y1="20" x2="18" y2="4"/&gt;&lt;line x1="6" y1="20" x2="6" y2="16"/&gt;&lt;/svg&gt;&lt;/div&gt;
          &lt;span&gt;Transactions&lt;/span&gt;
          &lt;strong id="statTxCount"&gt;0&lt;/strong&gt;
          &lt;small&gt;All time&lt;/small&gt;
        &lt;/div&gt;
        &lt;div class="nc3-stat"&gt;
          &lt;div class="nc3-stat-icon violet"&gt;&lt;svg viewBox="0 0 24 24" fill="#fff" stroke="none" width="22" height="22"&gt;&lt;polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/&gt;&lt;/svg&gt;&lt;/div&gt;
          &lt;span&gt;Days with us&lt;/span&gt;
          &lt;strong id="statDays"&gt;1&lt;/strong&gt;
          &lt;small&gt;Since registration&lt;/small&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/section&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- EXCHANGE DASHBOARD --&gt;
&lt;div id="exchangeDash" class="pg" style="display:none"&gt;&lt;/div&gt;

&lt;!-- MY CARDS --&gt;
&lt;div id="cards" class="pg"&gt;
  &lt;div class="sh"&gt;&lt;h2&gt;My Payment Cards&lt;/h2&gt;&lt;p&gt;Manage your NordicCrypto card&lt;/p&gt;&lt;/div&gt;
  &lt;div class="pay" style="max-width:420px" id="cardFull"&gt;
    &lt;div class="pay-shine"&gt;&lt;/div&gt;
    &lt;div class="ptop"&gt;&lt;div class="pb" id="cardBrandFull"&gt;NORDIC CRYPTO&lt;/div&gt;&lt;div class="pt" id="cardTypeFull"&gt;METAL VISA&lt;/div&gt;&lt;/div&gt;
    &lt;div class="chip-row"&gt;&lt;div class="chip-real"&gt;&lt;/div&gt;&lt;/div&gt;
    &lt;div class="pn" id="cardNumFull"&gt;— — — — &amp;nbsp; — — — — &amp;nbsp; — — — — &amp;nbsp; — — — —&lt;/div&gt;
    &lt;div class="pf"&gt;
      &lt;div&gt;&lt;div class="pl"&gt;CARD HOLDER&lt;/div&gt;&lt;div class="pv" id="cardNameFull"&gt;—&lt;/div&gt;&lt;/div&gt;
      &lt;div style="text-align:right"&gt;&lt;div class="pl"&gt;EXPIRES&lt;/div&gt;&lt;div class="pv m" id="cardExpFull"&gt;—/—&lt;/div&gt;&lt;/div&gt;
      &lt;div class="card-network" id="cardNetwork2"&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap"&gt;
    &lt;button class="btn b2" id="btnChangeDesign"&gt;🎨 Change Design&lt;/button&gt;
    &lt;button class="btn b2" id="btnShowCvv"&gt;👁 Show CVV&lt;/button&gt;
    &lt;button class="btn b2" id="btnFreeze"&gt;❄ Freeze Card&lt;/button&gt;
    &lt;button class="btn b3" id="btnDeleteCard"&gt;🗑 Delete Card&lt;/button&gt;
  &lt;/div&gt;
  &lt;div class="panel" style="margin-top:24px;max-width:520px"&gt;
    &lt;h4 style="margin-bottom:16px"&gt;Card Details&lt;/h4&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Card Number&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detNum"&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;CVV&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detCvv"&gt;●●●&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Expires&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detExp"&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Cardholder&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detName"&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Type&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detType"&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04)"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Currency&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detCur"&gt;—&lt;/span&gt;&lt;/div&gt;
    &lt;div style="display:flex;justify-content:space-between;padding:10px 0"&gt;&lt;span style="color:#94a3b8;font-size:13px"&gt;Status&lt;/span&gt;&lt;span style="font-family:ui-monospace;font-weight:600" id="detStatus"&gt;Active&lt;/span&gt;&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class="panel" style="margin-top:24px;max-width:520px"&gt;
    &lt;h4 style="margin-bottom:12px"&gt;Want a physical card?&lt;/h4&gt;
    &lt;p style="color:#94a3b8;font-size:.88rem;margin-bottom:16px"&gt;Order a premium metal card shipped to your address.&lt;/p&gt;
    &lt;button class="btn b1" id="btnGoOrder"&gt;Order Physical Card →&lt;/button&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- ASSETS --&gt;
&lt;div id="assets" class="pg"&gt;
  &lt;div class="sh"&gt;&lt;h2&gt;Crypto Portfolio&lt;/h2&gt;&lt;p&gt;Your crypto holdings&lt;/p&gt;&lt;/div&gt;
  &lt;div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px"&gt;
    &lt;div class="panel"&gt;&lt;div style="font-size:.72rem;color:#94a3b8"&gt;BITCOIN (BTC)&lt;/div&gt;&lt;div style="font-size:1.6rem;font-weight:700;margin-top:8px;font-family:ui-monospace" id="aBtc"&gt;0.00000000&lt;/div&gt;&lt;div style="color:#94a3b8;font-size:.85rem;margin-top:6px" id="aBtcU"&gt;≈ $0.00&lt;/div&gt;&lt;/div&gt;
    &lt;div class="panel"&gt;&lt;div style="font-size:.72rem;color:#94a3b8"&gt;ETHEREUM (ETH)&lt;/div&gt;&lt;div style="font-size:1.6rem;font-weight:700;margin-top:8px;font-family:ui-monospace" id="aEth"&gt;0.00000000&lt;/div&gt;&lt;div style="color:#94a3b8;font-size:.85rem;margin-top:6px" id="aEthU"&gt;≈ $0.00&lt;/div&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- TRANSACTIONS --&gt;
&lt;div id="tx" class="pg"&gt;
  &lt;div class="sh"&gt;&lt;h2&gt;Transaction History&lt;/h2&gt;&lt;p&gt;All activity on your account&lt;/p&gt;&lt;/div&gt;
  &lt;div class="tbl"&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Description&lt;/th&gt;&lt;th&gt;Amount&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody id="txB"&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;!-- RECEIVE CRYPTO --&gt;
&lt;div id="receive" class="pg"&gt;&lt;div id="rcPage"&gt;&lt;/div&gt;&lt;/div&gt;

&lt;!-- ORDER NEW CARD --&gt;
&lt;div id="order" class="pg"&gt;
  &lt;div id="orderForm"&gt;
    &lt;div class="sh"&gt;&lt;h2&gt;Order Physical Metal Card&lt;/h2&gt;&lt;p&gt;Premium NordicCrypto Metal shipped from Stockholm&lt;/p&gt;&lt;/div&gt;
    &lt;div class="panel" style="max-width:640px"&gt;
      &lt;h3 style="margin-bottom:18px;font-size:1.05rem"&gt;Shipping Details&lt;/h3&gt;
      &lt;div class="fr"&gt;
        &lt;div class="fg" style="flex:2"&gt;&lt;label&gt;Full Name&lt;/label&gt;&lt;input class="fc" id="oName" placeholder="Satoshi Sat Nakamoto"&gt;&lt;/div&gt;
        &lt;div class="fg" style="flex:1"&gt;&lt;label&gt;Card Type&lt;/label&gt;&lt;select class="fc" id="oType"&gt;&lt;option&gt;Metal (Free)&lt;/option&gt;&lt;option&gt;Gold (+$100)&lt;/option&gt;&lt;/select&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="fg"&gt;&lt;label&gt;Country&lt;/label&gt;&lt;select class="fc" id="oCountry"&gt;&lt;option&gt;Sweden&lt;/option&gt;&lt;option&gt;Norway&lt;/option&gt;&lt;option&gt;Finland&lt;/option&gt;&lt;option&gt;Denmark&lt;/option&gt;&lt;option&gt;Germany&lt;/option&gt;&lt;option&gt;United Kingdom&lt;/option&gt;&lt;option&gt;United States&lt;/option&gt;&lt;option&gt;Canada&lt;/option&gt;&lt;option&gt;Australia&lt;/option&gt;&lt;/select&gt;&lt;/div&gt;
      &lt;div class="fg"&gt;&lt;label&gt;City&lt;/label&gt;&lt;input class="fc" id="oCity" placeholder="Stockholm"&gt;&lt;/div&gt;
      &lt;div class="fg"&gt;&lt;label&gt;Street Address&lt;/label&gt;&lt;input class="fc" id="oStreet" placeholder="Drottninggatan 1"&gt;&lt;/div&gt;
      &lt;div class="fr"&gt;
        &lt;div class="fg" style="flex:1"&gt;&lt;label&gt;Postal Code&lt;/label&gt;&lt;input class="fc" id="oZip" placeholder="111 51"&gt;&lt;/div&gt;
        &lt;div class="fg" style="flex:1"&gt;&lt;label&gt;Phone&lt;/label&gt;&lt;input class="fc" id="oPhone" placeholder="+46..."&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;button class="btn b1" style="width:100%;justify-content:center" id="btnOrder"&gt;Place Order&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div id="orderTrack" class="hidden"&gt;
    &lt;div class="track-wrap"&gt;
      &lt;div style="display:flex;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:16px"&gt;
        &lt;div&gt;&lt;h2&gt;Track Your Card&lt;/h2&gt;&lt;p style="color:#94a3b8"&gt;Live tracking&lt;/p&gt;&lt;/div&gt;
        &lt;div class="track-id-box"&gt;&lt;div style="font-size:.7rem;color:#94a3b8"&gt;Tracking ID&lt;/div&gt;&lt;div style="font-family:ui-monospace;font-weight:700;color:#00d4ff;font-size:1.05rem" id="trackId"&gt;—&lt;/div&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="panel"&gt;
        &lt;div class="progress-steps" id="stepsWrap"&gt;
          &lt;div class="step"&gt;&lt;div class="step-dot"&gt;1&lt;/div&gt;&lt;div style="font-size:.7rem;color:#94a3b8;text-align:center;max-width:90px"&gt;Order Received&lt;/div&gt;&lt;/div&gt;
