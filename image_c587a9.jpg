    <span class="hljs-keyword">for</span> m <span class="hljs-keyword">in</span> <span class="hljs-built_in">sorted</span>(<span class="hljs-built_in">set</span>(missing)):
        print(<span class="hljs-string">" "</span>, m)

<span class="hljs-comment"># Check JS syntax errors across all js files using node if available</span>
<span class="hljs-keyword">import</span> subprocess
res = subprocess.run([<span class="hljs-string">"which"</span>, <span class="hljs-string">"node"</span>], capture_output=<span class="hljs-literal">True</span>, text=<span class="hljs-literal">True</span>)
print(<span class="hljs-string">"Node path:"</span>, res.stdout.strip())
<span class="hljs-keyword">if</span> res.stdout.strip():
    js_files = []
    <span class="hljs-keyword">for</span> root, dirs, files <span class="hljs-keyword">in</span> os.walk(base):
        <span class="hljs-keyword">for</span> fn <span class="hljs-keyword">in</span> files:
            <span class="hljs-keyword">if</span> fn.endswith(<span class="hljs-string">".js"</span>):
                js_files.append(os.path.join(root, fn))
    syntax_errs = []
    <span class="hljs-keyword">for</span> jf <span class="hljs-keyword">in</span> <span class="hljs-built_in">sorted</span>(js_files):
        r = subprocess.run([<span class="hljs-string">"node"</span>, <span class="hljs-string">"--check"</span>, jf], capture_output=<span class="hljs-literal">True</span>, text=<span class="hljs-literal">True</span>)
        <span class="hljs-keyword">if</span> r.returncode != <span class="hljs-number">0</span>:
            syntax_errs.append((jf, r.stderr.strip()))
