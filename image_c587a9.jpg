  <span class="hljs-attribute">background</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">69</span>, <span class="hljs-number">230</span>, <span class="hljs-number">176</span>, <span class="hljs-number">0.14</span>);
