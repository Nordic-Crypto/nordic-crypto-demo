# Copy to .env with: sh scripts/generate-secrets.sh — never commit .env.

# Your domain, pointed (DNS A record) at the server. Use "localhost" for a local test.
DOMAIN=chat.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# Generated automatically — long random values.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
# 32 random bytes (base64) — encrypts secrets at rest. Back it up: without it, 2FA secrets cannot be read.
DATA_ENCRYPTION_KEY=
