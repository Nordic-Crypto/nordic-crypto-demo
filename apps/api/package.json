    "@fastify/rate-limit": "^10.2.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^13.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.2",
    "ioredis": "^5.4.2",
    "otpauth": "^9.3.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
